<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <div>
        <h1 class="page-title">Request a Micro-Loan</h1>
        <p class="page-subtitle">Submit a micro-credit application to <%= group.name %></p>
      </div>
    </div>

    <% if (existingActiveLoan) { %>
      <div class="card" style="max-width: 650px; margin: 0 auto; text-align: center; padding: 2.5rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
        <h2 style="font-size: 1.35rem; color: var(--warning); font-weight: 800;">Active Loan Existing</h2>
        <p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem;">
          You already have an active micro-loan (<strong>#<%= existingActiveLoan._id.toString().slice(-6).toUpperCase() %></strong>) with status <strong><%= existingActiveLoan.status %></strong> and outstanding balance <strong>₹<%= existingActiveLoan.outstandingBalance.toLocaleString('en-IN') %></strong>.
        </p>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.5rem;">
          SHG rules require settling your ongoing loan before requesting a new micro-loan.
        </p>
        <a href="/loans/<%= existingActiveLoan._id %>" class="btn btn-primary">View Current Loan Schedule</a>
      </div>
    <% } else { %>
      <div class="card" style="max-width: 650px; margin: 0 auto;">
        <form action="/loans/request" method="POST" novalidate>
          <div class="form-group">
            <label for="amountRequested" class="form-label">Loan Amount Required (₹)</label>
            <input
              type="number"
              step="500"
              min="500"
              max="200000"
              id="amountRequested"
              name="amountRequested"
              class="form-control"
              placeholder="e.g. 10000"
              data-rate="<%= defaultInterestRate %>"
              value="<%= typeof formData !== 'undefined' && formData.amountRequested ? formData.amountRequested : '' %>"
              required
            >
            <small class="form-text">Micro-loans range from ₹500 to ₹2,00,000 according to SHG guidelines.</small>
          </div>

          <div class="form-group">
            <label for="purpose" class="form-label">Loan Purpose</label>
            <input
              type="text"
              id="purpose"
              name="purpose"
              class="form-control"
              placeholder="e.g. Purchase seeds & fertilizer, sewing machine, livestock"
              value="<%= typeof formData !== 'undefined' && formData.purpose ? formData.purpose : '' %>"
              required
            >
          </div>

          <div class="form-group">
            <label for="tenureMonths" class="form-label">Tenure Duration (Months)</label>
            <input
              type="number"
              min="1"
              max="60"
              id="tenureMonths"
              name="tenureMonths"
              class="form-control"
              placeholder="e.g. 6"
              value="<%= typeof formData !== 'undefined' && formData.tenureMonths ? formData.tenureMonths : '6' %>"
              required
            >
            <small class="form-text">Number of monthly instalments for repayment (1 to 60 months).</small>
          </div>

          <!-- Group Interest Policy Note -->
          <div style="background: var(--bg-subtle); padding: 0.85rem 1rem; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.25rem;">
            📌 <strong>SHG Group Policy:</strong> Interest rate is <strong><%= defaultInterestRate %>% p.a. simple interest</strong>. Monthly instalments will be generated upon approval.
          </div>

          <!-- Live Calculator Preview Widget -->
          <div id="calculatorPreview" class="calculator-preview" style="display: none;">
            <h4>Estimated Repayment Summary</h4>
            <div class="calc-row">
              <span>Principal Amount:</span>
              <span id="previewPrincipal">₹0</span>
            </div>
            <div class="calc-row">
              <span>Total Interest (<%= defaultInterestRate %>% p.a. simple interest):</span>
              <span id="previewInterest">₹0</span>
            </div>
            <div class="calc-row">
              <span>Monthly Instalment:</span>
              <span id="previewInstalment" style="color: var(--primary); font-weight: 700;">₹0 / mo</span>
            </div>
            <div class="calc-row">
              <span>Total Amount Payable:</span>
              <span id="previewTotal">₹0</span>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary btn-block">
              Submit Micro-Loan Application
            </button>
          </div>
        </form>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
