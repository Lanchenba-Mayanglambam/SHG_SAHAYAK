<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <div>
        <h1 class="page-title">My Micro-Loans</h1>
        <p class="page-subtitle">Track your loan applications, approval status, and repayments</p>
      </div>
      <div>
        <a href="/loans/request" class="btn btn-primary">Apply for New Loan</a>
      </div>
    </div>

    <% if (activeLoan && nextInstalment) { %>
      <div class="alert alert-info" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 0.75rem;">
        <div>
          <strong>Upcoming Repayment Due:</strong> Instalment #<%= nextInstalment.instalmentNumber %> of ₹<%= nextInstalment.amountDue.toLocaleString('en-IN') %> is due on <strong><%= dayjs(nextInstalment.dueDate).format('DD MMMM YYYY') %></strong>.
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <% if (group && group.isOnlinePaymentEnabled) { %>
            <a href="/loans/<%= activeLoan._id %>" class="btn btn-sm btn-primary">📱 Pay via UPI</a>
          <% } %>
          <a href="/loans/<%= activeLoan._id %>" class="btn btn-sm btn-outline-primary">View Schedule</a>
        </div>
      </div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Loan History</h2>
      </div>

      <% if (loans && loans.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Loan ID</th>
                <th>Purpose</th>
                <th>Principal</th>
                <th>Tenure</th>
                <th>Total Payable</th>
                <th>Balance Remaining</th>
                <th>Status</th>
                <th>Applied On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% loans.forEach(loan => { %>
                <tr>
                  <td><code>#<%= loan._id.toString().slice(-6).toUpperCase() %></code></td>
                  <td><strong><%= loan.purpose %></strong></td>
                  <td>₹<%= loan.amountRequested.toLocaleString('en-IN') %></td>
                  <td><%= loan.tenureMonths %> mo</td>
                  <td>
                    <%= loan.status !== 'pending' && loan.status !== 'rejected' ? `₹${loan.totalPayable.toLocaleString('en-IN')}` : '-' %>
                  </td>
                  <td style="font-weight: 700; color: <%= loan.outstandingBalance > 0 ? 'var(--danger)' : 'var(--success)' %>;">
                    <%= loan.status !== 'pending' && loan.status !== 'rejected' ? `₹${loan.outstandingBalance.toLocaleString('en-IN')}` : '-' %>
                  </td>
                  <td>
                    <span class="badge <%= loan.status %>"><%= loan.status %></span>
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-muted);"><%= dayjs(loan.createdAt).format('DD MMM YYYY') %></td>
                  <td>
                    <a href="/loans/<%= loan._id %>" class="btn btn-secondary btn-sm">View Schedule</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
          <h3>No Loans Found</h3>
          <p style="margin: 0.5rem 0 1.25rem;">You have not applied for any micro-loans yet.</p>
          <a href="/loans/request" class="btn btn-primary btn-sm">Apply for your first loan</a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
